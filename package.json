{
  "name": "enjanga-portfolio",
  "version": "0.2.0",
  "private": true,
  "repository": "git@github.com:ericnjanga/enjanga-portfolio.git",
  "bugs": "https://github.com/ericnjanga/enjanga-portfolio/issues",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm test && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint && tsc --noEmit",
    "ci-check": "yarn format:diff",
    "clean": "rimraf node_modules .next dist && yarn install",
    "clean:hard": "rimraf node_modules .next dist yarn.lock && yarn cache clean && yarn install",
    "format": "prettier --write \"**/*.{js,ts,md,scss}\"",
    "format:diff": "prettier --list-different \"**/*.{js,ts,md,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.87.0",
    "@carbon/pictograms-react": "^11.102.0",
    "@carbon/react": "^1.115.0",
    "@contentful/rich-text-types": "^17.2.7",
    "clsx": "^2.1.1",
    "enjanga-components-library": "1.0.122",
    "enjanga-core-setup": "file:../enjanga-core-setup",
    "next": "15.5.7",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-is": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/dotenv": "^8.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/smoothscroll-polyfill": "^0.3.4",
    "@vitejs/plugin-react": "^5.0.3",
    "dotenv": "^17.2.2",
    "eslint": "8.44.0",
    "eslint-config-next": "13.4.9",
    "graphql": "^16.14.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.26",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "whatwg-fetch": "^3.6.20"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --cache --write",
      "git add"
    ],
    "*.{scss,css}": [
      "prettier --cache --write",
      "git add"
    ],
    "*.md": [
      "prettier --cache --write",
      "git add"
    ]
  },
  "prettier": {
    "jsxBracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
